{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chaos-gacha:schema:curse",
  "title": "Gacha curse",
  "description": "One curse: a d20 severity, a mechanical hook, a machine-checkable Resolve and a mature flag (PROJECT_PLAN.md section 6.8, decision D2). The id is derived from the file path: data/<namespace>/curse/<path>.json is <namespace>:<path>.",
  "type": "object",
  "required": ["name", "description", "severity", "mature", "hook", "resolve"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "severity": {"type": "integer", "minimum": 1, "maximum": 20},
    "mature": {
      "type": "boolean",
      "description": "Ships behind a default-off config when true (D2 policy)."
    },
    "hook": {"$ref": "#/$defs/hook"},
    "resolve": {"$ref": "#/$defs/resolve"}
  },
  "$defs": {
    "hook": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "attribute", "operation", "amount"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "attribute"},
            "attribute": {"type": "string", "minLength": 1},
            "operation": {"enum": ["add", "multiply_base", "multiply_total"]},
            "amount": {"type": "number"}
          }
        },
        {
          "type": "object",
          "required": ["type", "effect"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "effect"},
            "effect": {"type": "string", "minLength": 1},
            "amplifier": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        },
        {
          "type": "object",
          "required": ["type", "mode", "deny"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "inventory"},
            "mode": {"enum": ["use", "hold", "pickup", "consume"]},
            "deny": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "entities", "behavior"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "mob"},
            "entities": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "minItems": 1,
              "uniqueItems": true
            },
            "behavior": {"enum": ["target", "spawn"]},
            "count": {"type": "integer", "minimum": 1},
            "interval": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "event"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "event"},
            "event": {
              "type": "string",
              "minLength": 1,
              "description": "An event id from the engine vocabulary; the set grows with the curse content."
            },
            "params": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean"]}
            }
          }
        }
      ]
    },
    "resolve": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "advancement"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "advancement"},
            "advancement": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "stat", "threshold"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "stat"},
            "stat": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"}
          }
        },
        {
          "type": "object",
          "required": ["type", "entity", "count"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "kill"},
            "entity": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "item", "count"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "collect"},
            "item": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "location"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "visit"},
            "location": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
