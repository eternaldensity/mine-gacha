{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chaos-gacha:schema:feat",
  "title": "Gacha feat",
  "description": "One feat: a stable id, a machine-checkable trigger, a tier and a ticket reward (PROJECT_PLAN.md sections 4.3 and 6.9). The id is derived from the file path: data/<namespace>/feat/<path>.json is <namespace>:<path>.",
  "type": "object",
  "required": ["name", "description", "trigger", "tier", "tickets"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "tier": {
      "enum": ["Trash", "Bronze", "Silver", "Gold", "Platinum", "Aluminium", "Diamond", "Legendary", "Mythical", "Divine", "Wild"]
    },
    "tickets": {
      "type": "object",
      "required": ["count", "category"],
      "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 16},
        "category": {
          "enum": ["ability", "trait", "skill", "item", "familiar", "random", "choice"]
        },
        "advantage": {"type": "integer", "minimum": 1, "maximum": 6}
      }
    },
    "trigger": {"$ref": "#/$defs/trigger"},
    "line": {
      "type": "string",
      "pattern": "^[a-z0-9_./-]+$",
      "description": "Optional diminishing-returns grouping; each step of a line is its own feat with its own stable id."
    },
    "power_relative": {
      "type": "boolean",
      "description": "True when the effective tier shifts with the Power Score (PROJECT_PLAN.md section 6.9, step B)."
    }
  },
  "$defs": {
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "advancement"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "advancement"},
            "advancement": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "stat", "threshold"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "stat"},
            "stat": {"type": "string", "minLength": 1},
            "threshold": {"type": "number"}
          }
        },
        {
          "type": "object",
          "required": ["type", "entity", "count"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "kill"},
            "entity": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "item", "count"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "collect"},
            "item": {"type": "string", "minLength": 1},
            "count": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "location"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "visit"},
            "location": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
